# AMD Radeon Cloud & Local ROCm Configuration
AMD_CLOUD_URL=http://127.0.0.1:8000/v1
AMD_CLOUD_KEY=your_amd_cloud_api_token_here

# Memory Configuration
SQLITE_DB_PATH=data/agenticai.db
CHROMA_DB_PATH=data/chroma
DOCUMENTS_PATH=data/documents

# Cost Tracking (Simulated or Local Quota)
COST_WARNING_THRESHOLD=1.0  # USD
COST_LIMIT=2.0  # USD monthly limit

# Security Settings
ALLOWED_FILE_TYPES=[".py",".pdf",".txt",".md",".json",".yaml",".yml"]
MAX_FILE_SIZE_MB=10
REQUIRE_PERMISSION_PROMPT=true

# Performance Settings
MAX_TOKENS_PER_REQUEST=4000
TEMPERATURE=0.7
REQUEST_TIMEOUT=30
